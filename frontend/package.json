{
  "name": "intellivoice-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "IntelliVoice frontend: React + TypeScript (Vite) with a small Express server",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "demo": "concurrently -n server,client -c magenta,cyan \"npm:demo:server\" \"npm:dev:client\"",
    "demo:server": "tsx server/index.ts --demo",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "http-proxy-middleware": "3.0.3",
    "multer": "1.4.5-lts.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "tsx": "4.19.2"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.9",
    "@types/express": "4.17.21",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
